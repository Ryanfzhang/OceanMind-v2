{
  "name": "@ocean-partner/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first desktop workbench for ocean research tasks.",
  "author": "Ocean Research Partner contributors",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && node scripts/build-preload.mjs && vite build",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "typecheck": "npm run check",
    "e2e:check": "tsc -p tsconfig.e2e.json",
    "e2e": "npm run e2e:check && npm run build && playwright test",
    "e2e:research": "npm run e2e:check && npm run build && playwright test research-interactions.spec.ts",
    "benchmark:smoke": "npm run build && node scripts/benchmark-desktop.mjs",
    "start": "node scripts/ensure-sidecar.mjs && npm run build && node scripts/start-electron.mjs",
    "start:cached": "node scripts/ensure-sidecar.mjs && node scripts/start-electron.mjs",
    "dev": "node scripts/ensure-sidecar.mjs && tsc -p tsconfig.main.json && node scripts/build-preload.mjs && node scripts/dev-electron.mjs",
    "verify:sidecar": "node scripts/verify-sidecar.mjs",
    "verify:package": "node scripts/verify-packaged-sidecar.mjs",
    "verify:package-launch": "node scripts/verify-packaged-desktop-launch.mjs",
    "verify:signature": "node scripts/verify-signed-package.mjs",
    "sign:update-manifest": "node scripts/sign-update-manifest.mjs",
    "package:dir": "npm run build && npm run verify:sidecar && electron-builder --dir && npm run verify:package",
    "package:release:mac": "node scripts/package-release.mjs mac",
    "package:release:win": "node scripts/package-release.mjs win",
    "package:release:mac:signed": "node scripts/package-release.mjs mac --signed",
    "package:release:win:signed": "node scripts/package-release.mjs win --signed",
    "lint": "eslint src --max-warnings=40",
    "lint:report": "eslint src"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "katex": "^0.16.22",
    "lucide-react": "^1.24.0",
    "maplibre-gl": "^5.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.4",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "org.oceanpartner.desktop",
    "productName": "Ocean Research Partner",
    "icon": "assets/ocean-partner-icon.png",
    "files": [
      "dist/renderer/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/update-config.json",
        "to": "update-config.json"
      },
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "assets/ocean-partner-icon.icns",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "icon": "assets/ocean-partner-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
