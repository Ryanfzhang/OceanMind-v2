{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "react": ["../../ocean-desktop/node_modules/@types/react"],
      "react/jsx-runtime": ["../../ocean-desktop/node_modules/@types/react/jsx-runtime.d.ts"],
      "lucide-react": ["../../ocean-desktop/node_modules/lucide-react/dist/lucide-react.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
