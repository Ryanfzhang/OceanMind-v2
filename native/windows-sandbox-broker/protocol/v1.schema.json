{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oceanpartner.local/schemas/windows-sandbox-broker-request-v1.json",
  "title": "Ocean Windows Sandbox Broker request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "executable",
    "arguments",
    "cwd",
    "roots",
    "output_root",
    "temporary_root",
    "environment",
    "limits",
    "allow_child_processes"
  ],
  "properties": {
    "schema_version": {"const": "ocean-windows-sandbox-broker/v1"},
    "executable": {"type": "string", "minLength": 1, "maxLength": 32768},
    "arguments": {
      "type": "array",
      "maxItems": 127,
      "items": {"type": "string", "minLength": 1, "maxLength": 32768}
    },
    "cwd": {"type": "string", "minLength": 1, "maxLength": 32768},
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "runtime_read", "writable"],
      "properties": {
        "read_only": {"$ref": "#/$defs/roots"},
        "runtime_read": {"$ref": "#/$defs/roots"},
        "writable": {"$ref": "#/$defs/roots"}
      }
    },
    "output_root": {"type": "string", "minLength": 1, "maxLength": 32768},
    "temporary_root": {"type": "string", "minLength": 1, "maxLength": 32768},
    "environment": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"type": "string", "maxLength": 32768}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_time_seconds",
        "cpu_time_seconds",
        "memory_bytes",
        "disk_bytes",
        "process_count",
        "open_files",
        "stdout_bytes",
        "stderr_bytes",
        "output_file_count",
        "output_total_bytes",
        "termination_grace_seconds"
      ],
      "properties": {
        "wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "cpu_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "memory_bytes": {"type": "number", "exclusiveMinimum": 0},
        "disk_bytes": {"type": "number", "exclusiveMinimum": 0},
        "process_count": {"type": "number", "exclusiveMinimum": 0},
        "open_files": {"type": "number", "exclusiveMinimum": 0},
        "stdout_bytes": {"type": "number", "exclusiveMinimum": 0},
        "stderr_bytes": {"type": "number", "exclusiveMinimum": 0},
        "output_file_count": {"type": "number", "exclusiveMinimum": 0},
        "output_total_bytes": {"type": "number", "exclusiveMinimum": 0},
        "termination_grace_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "allow_child_processes": {"const": false}
  },
  "$defs": {
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 32768}
    }
  }
}
